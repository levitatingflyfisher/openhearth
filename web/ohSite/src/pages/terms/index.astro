---
import Base from '../../layouts/Base.astro';
---

<Base title="Terms · OpenHearth" description="OpenHearth apps are free software under the MIT License, provided as is.">
  <main class="terms-page">
    <div class="container">

      <header class="page-header reveal d1">
        <p class="page-eyebrow">OpenHearth</p>
        <h1>Terms</h1>
      </header>

      <div class="prose">
        <section class="prose-section reveal d2">
          <p>
            OpenHearth apps are free software under the MIT License. They are provided
            as is, with no warranty of any kind.
          </p>
          <p>
            <a href="https://opensource.org/license/mit">Read the MIT License</a>
          </p>
        </section>
      </div>

    </div>
  </main>
</Base>

<style>
  .terms-page {
    padding-top: 100px; /* clear fixed nav */
    padding-bottom: 96px;
    min-height: 100vh;
    background: var(--bg);
  }

  /* ── Page header ── */
  .page-header {
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 56px;
  }
  .page-eyebrow {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .page-header h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.1;
    margin-bottom: 14px;
  }
  .page-meta {
    font-size: 13px;
    color: var(--text-ter);
    font-family: var(--font-ui);
  }

  /* ── Prose layout ── */
  .prose {
    max-width: 720px;
  }
  .prose-section {
    padding: 40px 0;
  }
  .prose-section + .rule {
    margin: 0;
  }
  .rule {
    border: none;
    height: 1px;
    background: var(--border);
  }

  /* ── Typography ── */
  .prose-section h2 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 16px;
    line-height: 1.2;
  }
  .prose-section p {
    font-size: 1rem;
    color: var(--text-sec);
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .prose-section p:last-child {
    margin-bottom: 0;
  }
  .prose-section a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.18s;
  }
  .prose-section a:hover {
    color: var(--accent-hover);
  }
  .prose-section strong {
    color: var(--text);
    font-weight: 600;
  }

  /* ── Block quote (MIT license excerpt) ── */
  blockquote {
    margin: 20px 0;
    padding: 18px 24px;
    border-left: 3px solid var(--accent);
    background: var(--bg-tinted);
    border-radius: 0 var(--oh-r-md) var(--oh-r-md) 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--text-sec);
  }

  /* ── Responsive ── */
  @media (max-width: 980px) {
    .terms-page {
      padding-top: 88px;
      padding-bottom: 72px;
    }
    .page-header {
      padding: 40px 0 36px;
      margin-bottom: 40px;
    }
  }
  @media (max-width: 640px) {
    .terms-page {
      padding-top: 76px;
      padding-bottom: 56px;
    }
    .page-header {
      padding: 32px 0 28px;
      margin-bottom: 32px;
    }
    .prose-section {
      padding: 28px 0;
    }
    .prose-section h2 {
      font-size: 1.2rem;
    }
    blockquote {
      padding: 14px 16px;
      font-size: 0.75rem;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
