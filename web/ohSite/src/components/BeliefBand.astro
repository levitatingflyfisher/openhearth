---
// BeliefBand — section 2 of the home page
// Single large centered value statement; last sentence rendered faint via --text-ter.
// Tinted background, generous vertical padding.
---

<section class="belief" aria-label="Our belief">
  <div class="container">
    <p class="belief-statement reveal d1">
      We believe family life deserves software that feels
      <em>home-cooked</em>, made with the same care as a Sunday dinner,
      by people who think raising kids well is the work that matters most.{" "}
      <span class="belief-coda">Everything we ship follows from that.</span>
    </p>
  </div>
</section>

<style>
  .belief {
    background: var(--bg-tinted);
    padding: 100px 0;
    text-align: center;
  }

  .belief-statement {
    font-family: var(--font-heading);
    font-size: clamp(22px, 3.5vw, 36px);
    line-height: 1.5;
    font-weight: 600;
    color: var(--text);
    max-width: 760px;
    margin: 0 auto;
    letter-spacing: -0.2px;
  }

  .belief-statement em {
    font-style: italic;
    color: var(--accent);
  }

  .belief-coda {
    color: var(--text-ter);
  }

  @media (max-width: 980px) {
    .belief {
      padding: 80px 0;
    }

    .belief-statement {
      font-size: clamp(20px, 3vw, 30px);
    }
  }

  @media (max-width: 640px) {
    .belief {
      padding: 64px 0;
    }

    .belief-statement {
      font-size: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
