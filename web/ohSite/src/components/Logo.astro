---
interface Props {
  /** If true, the whole thing is wrapped in an `<a>`. Default true. */
  linked?: boolean;
  /** Href for the logo link. Defaults to "/". */
  href?: string;
}
const defaultHref = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const { linked = true, href = defaultHref } = Astro.props;
---

{linked ? (
  <a href={href} class="oh-logo">
    <span class="oh-logo-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2C8 7 6 10 6 14a6 6 0 0012 0c0-4-2-7-6-12z"/>
        <path d="M12 14c0-3 1.5-5 3-6-1 3-1 5 0 6"/>
      </svg>
    </span>
    <span class="oh-logo-name">OpenHearth</span>
  </a>
) : (
  <span class="oh-logo">
    <span class="oh-logo-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2C8 7 6 10 6 14a6 6 0 0012 0c0-4-2-7-6-12z"/>
        <path d="M12 14c0-3 1.5-5 3-6-1 3-1 5 0 6"/>
      </svg>
    </span>
    <span class="oh-logo-name">OpenHearth</span>
  </span>
)}

<style>
  .oh-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .oh-logo-icon {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--oh-hearth-500);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .oh-logo-icon svg {
    width: 17px;
    height: 17px;
  }
  .oh-logo-name {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.2px;
  }
</style>
