<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Android backup is the phone owner's choice, so
     the rest of the app's data goes in. Two things stay out:
     - flutter_secure_storage's file, which holds the identity entropy (the
       12 words) and the state-file key. Their wrapping key lives in the
       Android keystore and does not travel, so a restored copy would be
       unreadable anyway, and the words must not reach Google.
     - files/backups, Porch's own backup files. Each holds the identity and
       every group, locked by the 6 backup words. It leaves the phone only
       when the person shares it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="file" path="backups" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="file" path="backups" />
    </device-transfer>
</data-extraction-rules>
