<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Android backup is the phone owner's choice, as
     the owner ruled: the database and the rest go in. The one exclusion is
     flutter_secure_storage's file, which holds the recovery words. Their
     key lives in the Android keystore and does not travel, so a restored
     copy would be unreadable anyway, and the words must not reach Google. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
