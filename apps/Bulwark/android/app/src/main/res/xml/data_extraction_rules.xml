<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The recovery words and device id sit in this file
     (flutter_secure_storage). They stay out of Google backup and out of
     device-to-device transfer. Everything else is left as it was. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
