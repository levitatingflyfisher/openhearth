    <exclude domain="root" path="app_flutter/qwen25-0-5b-it-q8.task.part"/>
    <exclude domain="root" path="app_flutter/qwen25-1-5b-it-int8.task"/>
    <exclude domain="root" path="app_flutter/qwen25-1-5b-it-int8.task.part"/>
    <exclude domain="root" path="app_flutter/phi4-mini-it-int8.task"/>
    <exclude domain="root" path="app_flutter/phi4-mini-it-int8.task.part"/>
</full-backup-content>
